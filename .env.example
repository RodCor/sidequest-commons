# Public repository coordinates used for links and read-only data fetching.
NEXT_PUBLIC_GITHUB_OWNER=RodCor
NEXT_PUBLIC_GITHUB_REPO=sidequest-commons
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only token for higher GitHub API rate limits. Never expose it
# with a NEXT_PUBLIC_ prefix and never place real values in this file.
GITHUB_READ_TOKEN=
